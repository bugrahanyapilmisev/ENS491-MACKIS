# ══════════════════════════════════════════════════════════════════════════════
# MACKIS — Environment Variables Template
# Copy this file to .env and fill in your own values.
# Never commit .env or .env.test to version control.
# ══════════════════════════════════════════════════════════════════════════════

# ── Database (Supabase) ───────────────────────────────────────────────────────
# Use the "Session Mode" pooler URL (port 6543) for the app.
# Use the "Transaction Mode" pooler or direct URL (port 5432) for migrations.
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres

# ── JWT Authentication ────────────────────────────────────────────────────────
JWT_SECRET_KEY=<generate-a-long-random-hex-string>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── File Paths ────────────────────────────────────────────────────────────────
PREPROCESSING_PATH=/path/to/ENS491-MACKIS/preprocessing

# ── ChromaDB (local vector store — optional when USE_PGVECTOR=true) ───────────
CHROMA_DIR_V2=/path/to/ENS491-MACKIS/creating_database/chroma_db_v2
COLL_NAME_V3=mysu_v3_qwen3

# ── BM25 Index ────────────────────────────────────────────────────────────────
CHECKPOINT_DIR_V2=/path/to/ENS491-MACKIS/creating_database/checkpoints_v2
BM25_INDEX_PATH=/path/to/ENS491-MACKIS/creating_database/checkpoints_v2/bm25_index_v3.pkl

# ── Reranker Model ────────────────────────────────────────────────────────────
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3

# ── Ollama (local — only needed if EMBED_PROVIDER=ollama or offline chat) ─────
OLLAMA_HOST=http://localhost:11434

# ── LLM & Embedding via OpenRouter ───────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-<your-openrouter-api-key>
CHAT_MODEL=qwen/qwen3-32b
EMBED_PROVIDER=openrouter
EMBED_MODEL=qwen/qwen3-embedding-8b
EMBED_MODEL_OPENROUTER=qwen/qwen3-embedding-8b
EMBED_DIM=4096

# Instruction prefixes for Qwen3-Embedding (instruction-aware retrieval)
EMBED_INSTRUCTION_QUERY=Instruct: Given a user question about university policies, retrieve the most relevant university policy document chunk\nQuery:
EMBED_INSTRUCTION_DOC=Instruct: Represent this university policy document chunk for retrieval\nDocument:

# ── pgvector (Supabase-backed vector search) ──────────────────────────────────
# Set to true to use Supabase pgvector instead of local ChromaDB for retrieval.
USE_PGVECTOR=true
# Matryoshka truncation: first 1024 dims of 4096-dim Qwen3 vectors.
# Keeps vectors within pgvector HNSW index limit (max 2000 dims).
EMBED_TRUNCATE_DIM=1024

# ── Evaluation Judge (Gemini) ─────────────────────────────────────────────────
GEMINI_API_KEY=<your-gemini-api-key>
JUDGE_PROVIDER=gemini
JUDGE_MODEL=gemini-2.5-flash

# ── RAG Retrieval Parameters ──────────────────────────────────────────────────
CE_SCORE_THRESHOLD=0.50
MAX_DOCS_CONTEXT=8
TOP_K_FINAL_MAX=20
TOP_K_CHROMA=80
CROSS_MAX_CANDIDATES=40
CROSS_WEIGHT=0.65
TOP_K_BM25=48
OLLAMA_MAX_RETRIES=1
OLLAMA_CHAT_TIMEOUT=900

# Hybrid retrieval weights (must sum to 1.0)
BM25_WEIGHT=0.35
VECTOR_WEIGHT=0.65

# ── Template Document Penalty ─────────────────────────────────────────────────
# Comma-separated substrings matched against source_path + title.
# Chunks from matching documents get score * 0.15 during reranking.
TEMPLATE_DOC_PATTERNS=hibe_sozlesmesi,bilgi_formu,basvuru_formu,application_form,grant_agreement

# ── Negation Backend ──────────────────────────────────────────────────────────
NEGATION_BACKEND=llm

# ── Chunking Parameters (used during index build only) ───────────────────────
CHUNK_SIZE_TARGET=512
CHUNK_SIZE_MAX=800
CHUNK_SIZE_MIN=200
CHUNK_OVERLAP=100
CHUNK_HARD_CAP=2000

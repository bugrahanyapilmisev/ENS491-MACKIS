# ══════════════════════════════════════════════════════════════════════════════
# MACKIS — Test Environment Variables Template
# Copy this file to .env.test and fill in your own values.
# Never commit .env.test to version control.
# ══════════════════════════════════════════════════════════════════════════════

# ── Database (Supabase — Transaction Mode, port 5432) ────────────────────────
# Use the Transaction Mode pooler URL (port 5432) for tests.
#
# How to find your values:
#   XXXXXXXXXXXX  → Your Supabase Project Reference ID
#                   Found at: Supabase Dashboard → Settings → General → Project ID
#                   Also visible in your project URL: https://XXXXXXXXXXXX.supabase.co
#
#   your_password → Your Supabase database password
#                   Found at: Supabase Dashboard → Settings → Database → Database password
#
#   aws-1-eu-central-1 → Your project's AWS region (shown in the pooler URL)
#                        Found at: Supabase Dashboard → Settings → Database → Connection string
#
TEST_DATABASE_URL=postgresql://postgres.XXXXXXXXXXXX:your_password@aws-1-eu-central-1.pooler.supabase.com:5432/postgres

# ── JWT Authentication ────────────────────────────────────────────────────────
# Must match the JWT_SECRET_KEY in your main .env file.
JWT_SECRET_KEY=your_secret_key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
